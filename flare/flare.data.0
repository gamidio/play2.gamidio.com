#: ../../../src/Stats.cpp:39
msgid "Max HP"
msgstr "HP Maksimal"

#: ../../../src/Stats.cpp:40
msgid "Total amount of HP."
msgstr "Jumlah total HP."

#: ../../../src/Stats.cpp:46
msgid "HP Regen"
msgstr "Regenerasi HP"

#: ../../../src/Stats.cpp:47
msgid "Ticks of HP regen per minute."
msgstr "Kutu regenerasi HP per menit."

#: ../../../src/Stats.cpp:53
msgid "Max MP"
msgstr "MP Maksimal"

#: ../../../src/Stats.cpp:54
msgid "Total amount of MP."
msgstr "Jumlah total MP."

#: ../../../src/Stats.cpp:60
msgid "MP Regen"
msgstr "Regenerasi MP"

#: ../../../src/Stats.cpp:61
msgid "Ticks of MP regen per minute."
msgstr "Kutu regenerasi MP per menit."

#: ../../../src/Stats.cpp:67
msgid "Accuracy"
msgstr "Akurasi"

#: ../../../src/Stats.cpp:68
msgid ""
"Accuracy rating. The enemy's Avoidance rating is subtracted from this value "
"to calculate your likeliness to land a direct hit."
msgstr ""
"Peringkat akurasi. Peringkat Penghindaran musuh dikurangi dari nilai ini "
"untuk menghitung kemungkinan Anda mendaratkan pukulan langsung."

#: ../../../src/Stats.cpp:74
msgid "Avoidance"
msgstr "Penghindaran"

#: ../../../src/Stats.cpp:75
msgid ""
"Avoidance rating. This value is subtracted from the enemy's Accuracy rating "
"to calculate their likeliness to land a direct hit."
msgstr ""
"Peringkat penghindaran. Nilai ini dikurangi dari peringkat Akurasi musuh "
"untuk menghitung kemungkinan mereka mendaratkan serangan langsung."

#: ../../../src/Stats.cpp:82 ../../../src/Stats.cpp:89
msgid "Reduces the amount of damage taken."
msgstr "Mengurangi jumlah damage yang diterima."

#: ../../../src/Stats.cpp:95
msgid "Critical Hit Chance"
msgstr "Peluang Pukulan Kritis"

#: ../../../src/Stats.cpp:96
msgid "Chance for an attack to do extra damage."
msgstr "Peluang serangan untuk melakukan damage tambahan."

#: ../../../src/Stats.cpp:102
msgid "Bonus XP"
msgstr "XP Bonus"

#: ../../../src/Stats.cpp:103
msgid "Increases the XP gained per kill."
msgstr "Meningkatkan XP yang diperoleh tiap membunuh."

#: ../../../src/Stats.cpp:109
#, c-format
msgid "Bonus %s"
msgstr "Bonus %s"

#: ../../../src/Stats.cpp:110
#, c-format
msgid "Increases the %s found per drop."
msgstr "meningkatkan %s penemuan tiap menjatuhkan."

#: ../../../src/Stats.cpp:116
msgid "Item Find Chance"
msgstr "Peluang Penemukan Item"

#: ../../../src/Stats.cpp:117
msgid "Increases the chance that an enemy will drop an item."
msgstr "Meningkatkan kemungkinan musuh akan menjatuhkan item."

#: ../../../src/Stats.cpp:123
msgid "Stealth"
msgstr "Sembunyi"

#: ../../../src/Stats.cpp:124
msgid "Increases your ability to move undetected."
msgstr "Meningkatkan kemampuan Anda untuk bergerak tanpa terdeteksi."

#: ../../../src/Stats.cpp:130
msgid "Poise"
msgstr "Seimbang"

#: ../../../src/Stats.cpp:131
msgid "Reduces your chance of stumbling when hit."
msgstr "Mengurangi kemungkinan Anda tersandung saat terkena."

#: ../../../src/Stats.cpp:137
msgid "Missile Reflect Chance"
msgstr "Peluang Refleksi Rudal"

#: ../../../src/Stats.cpp:138
msgid "Increases your chance of reflecting missiles back at enemies."
msgstr "Meningkatkan peluang Anda untuk memantulkan rudal kembali ke musuh."

#: ../../../src/Stats.cpp:144
msgid "Damage Reflection"
msgstr "Damage Refleksi"

#: ../../../src/Stats.cpp:145
msgid "Deals a percentage of damage taken back to the attacker."
msgstr "Memberikan persentase kerusakan yang dikembalikan ke penyerang."

#: ../../../src/Stats.cpp:151
msgid "HP Steal"
msgstr "Pencurian HP"

#: ../../../src/Stats.cpp:152
msgid "Percentage of HP stolen per hit."
msgstr "Persentase HP yang dicuri per pukulan."

#: ../../../src/Stats.cpp:158
msgid "MP Steal"
msgstr "Pencurian MP"

#: ../../../src/Stats.cpp:159
msgid "Percentage of MP stolen per hit."
msgstr "Persentase MP yang dicuri per pukulan."

#: ../../../src/Stats.cpp:165
msgid "Resist Damage-Over-Time"
msgstr ""

#: ../../../src/Stats.cpp:166
msgid "Percentage chance that damage-over-time effects will be negated."
msgstr ""
"Persentase peluang bahwa efek kerusakan seiring waktu akan dinegasikan."

#: ../../../src/Stats.cpp:172
msgid "Resist Slow"
msgstr ""

#: ../../../src/Stats.cpp:173
msgid "Percentage chance that slow effects will be negated."
msgstr "Persentase peluang bahwa efek lambat akan dinegasikan."

#: ../../../src/Stats.cpp:179
msgid "Resist Stun"
msgstr ""

#: ../../../src/Stats.cpp:180
msgid "Percentage chance that stun effects will be negated."
msgstr "Persentase peluang efek stun akan dinegasikan."

#: ../../../src/Stats.cpp:186
msgid "Resist Knockback"
msgstr ""

#: ../../../src/Stats.cpp:187
msgid "Percentage chance that knockback effects will be negated."
msgstr "Persentase peluang efek knockback akan dinegasikan."

#: ../../../src/Stats.cpp:193
msgid "Resist Stat Debuffs"
msgstr ""

#: ../../../src/Stats.cpp:194
msgid "Percentage chance that stat debuff effects will be negated."
msgstr "Persentase peluang bahwa efek debuff stat akan dinegasikan."

#: ../../../src/Stats.cpp:200
msgid "Resist Damage Reflection"
msgstr ""

#: ../../../src/Stats.cpp:201
msgid "Percentage chance that damage reflection will be negated."
msgstr "Persentase kemungkinan refleksi kerusakan akan dinegasikan."

#: ../../../src/Stats.cpp:207
msgid "Resist HP Steal"
msgstr ""

#: ../../../src/Stats.cpp:208
msgid "Percentage chance that HP steal will be negated."
msgstr "Persentase peluang mencuri HP akan dinegasikan."

#: ../../../src/Stats.cpp:214
msgid "Resist MP Steal"
msgstr ""

#: ../../../src/Stats.cpp:215
msgid "Percentage chance that MP steal will be negated."
msgstr "Persentase peluang mencuri MP akan dinegasikan."

