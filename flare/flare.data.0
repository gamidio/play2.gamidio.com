### Page 1
[text]
text_pos=155,70,400,left
text_font=128,0,0,font_cursive
text=1462/8/12
requires_status=emp_il_notes_6

[text]
text_pos=155,120,400,left
text_font=0,0,0,font_cursive
text=It's finally over! We reached a massive chamber inhabited by a giant antlion! The mages were able to hold it back while we grabbed everything that wasn't nailed down. Thought we were trapped when we had to barricade the gate. Thank the heavens that the portal brought us back here.
requires_status=emp_il_notes_6

[text]
text_pos=155,560,400,center
text_font=128,0,0,font_regular
text=[Missing page]
requires_not_status=emp_il_notes_6

### Page 2
# [text]
# text_pos=605,70,400,left
# text_font=128,0,0,font_cursive
# text=
# requires_status=emp_il_notes_6

[text]
text_pos=605,120,400,left
text_font=0,0,0,font_cursive
text=A few of the guys were still working on the floor above and didn't follow us into the chamber. We'll head back down and rendezvous with them tomorrow.
requires_status=emp_il_notes_6

[text]
text_pos=605,560,400,center
text_font=128,0,0,font_regular
text=[Missing page]
requires_not_status=emp_il_notes_6

