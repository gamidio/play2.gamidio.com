### Page 1
[text]
text_pos=155,70,400,left
text_font=128,0,0,font_cursive
text=1462/3/10
requires_status=emp_il_notes_1

[text]
text_pos=155,120,400,left
text_font=0,0,0,font_cursive
text=The dig near Perdition Harbor is starting to show promise. We found ruins. Unlike anything else in the area. We'll get a good amount of gold from the relics here. A welcome change for the guys that transferred from the Empyrean's operation in the complex under Lochport.
requires_status=emp_il_notes_1

[text]
text_pos=155,560,400,center
text_font=128,0,0,font_regular
text=[Missing page]
requires_not_status=emp_il_notes_1

### Page 2
[text]
text_pos=605,120,400,left
text_font=0,0,0,font_cursive
text=They told me about the other expeditions, a tower in Black Oak City and a temple in the Stormrock region. Both just as fruitless.
requires_status=emp_il_notes_1

[text]
text_pos=605,560,400,center
text_font=128,0,0,font_regular
text=[Missing page]
requires_not_status=emp_il_notes_1

