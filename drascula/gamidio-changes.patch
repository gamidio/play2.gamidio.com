--- a/index.html
+++ b/index.html
@@ -0,0 +1,30 @@
+<!doctype html>
+<html lang="en"><head>
+<script src="gamidio-touch.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Drascula: The Vampire Strikes Back</title>
+<script>/* Gamidio: keyboard focus on click, game keys do not scroll the page around the game */(function(){var f=function(){window.focus()};addEventListener('mousedown',f,true);addEventListener('touchstart',f,{capture:true,passive:true});addEventListener('keydown',function(e){if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' ','PageUp','PageDown','Home','End'].indexOf(e.key)>=0&&!/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName))e.preventDefault()},true)})()</script>
+<style>html,body{margin:0;height:100%;overflow:hidden;background:#000}
+canvas{position:absolute;top:0;left:0;width:100%;height:100%;display:block;outline:none}
+#load{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:2;background:#000;color:#ddd;font:16px/1.5 system-ui,sans-serif;text-align:center;pointer-events:none}</style>
+</head><body><canvas id="canvas" tabindex="-1" oncontextmenu="event.preventDefault()"></canvas><div id="load">Loading…</div>
+<script>
+(function(){
+  var base=new URL("../scummvm/",location.href).href,load=document.getElementById("load"),pending=0,f=window.fetch;
+  function show(){load.style.display=pending>0?"flex":"none"}
+  window.fetch=function(u,o){
+    if(typeof u!=="string"||u.charAt(0)!=="/"||u.charAt(1)==="/")return f.call(this,u,o);
+    var big=u.indexOf("/data/games/")===0&&!/index\.json$/.test(u);
+    if(big){pending++;load.textContent="Loading game data…";show()}
+    var r=f.call(this,base+u.slice(1),o);
+    if(big)r.then(function(res){return res.clone().arrayBuffer()}).catch(function(){}).then(function(){pending--;show()});
+    return r};
+  // The games use F1-F10 (F5 = save or menu): the browser must not reload the page or open its help on them.
+  addEventListener("keydown",function(e){if(/^F([1-9]|10)$/.test(e.key))e.preventDefault()},true);
+  history.replaceState(null,"",location.pathname+location.search+"#"+"--path=/data/games/drascula --auto-detect");
+  window.Module={canvas:document.getElementById("canvas"),locateFile:function(p){return base+p},
+    print:function(){},printErr:function(t){console.warn(t)},
+    setStatus:function(t){if(!pending){load.textContent=t?"Loading…":"";load.style.display=t?"flex":"none"}}};
+})();
+</script>
+<script async src="../scummvm/scummvm.js"></script>
+</body></html>
